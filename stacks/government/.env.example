# ==============================================================================================
# DogTag — GOVERNMENT stack env (REMOTE / PRODUCTION template). Copy to `.env` and fill in.
# ----------------------------------------------------------------------------------------------
# The government credential authority issues authority-endorsed TRAVEL_CLEARANCE / EU_HEALTH_CERT
# credentials and records government-grade verifications against the ROAX contracts. It is a
# SEPARATE deployable (own docker-compose, own Mongo, own signer) — see docs/ROLE_APPS.md.
#
# Local/demo: set GOV_DEMO_MODE=1 for the ephemeral MemStore (no Mongo). That does NOT change the
# chain: the chain backend is the separate GOV_CHAIN_BACKEND switch below and defaults to the REAL
# node. This file is the REMOTE/production template, consumed by
# stacks/government/docker-compose.yml. To target a DIFFERENT chain, change ROAX_RPC + CHAIN_ID +
# the *_ADDR addresses below - no code edits.
# ==============================================================================================

# ---- Chain (config-only swap to a different chain) -------------------------------------------
ROAX_RPC=https://devrpc.roax.net
CHAIN_ID=135

# ---- Persistent store (Mongo, internal to the compose network only) --------------------------
MONGO_URI=mongodb://mongo:27017/dogtag
MONGO_DB=dogtag

# ---- Listener port ---------------------------------------------------------------------------
PORT=44832

# ---- This deployment's public identity (issuer binding) --------------------------------------
# DEPLOYMENT_URL is also the host every QR encodes — the record-share QR (`/r/<token>`) and the
# owner-hidden verify QR (`/x/<token>?a=<relayer>`). It MUST be reachable from the OWNER'S PHONE, so
# `localhost` only ever works on the same machine: use the LAN IP for a local demo (what
# scripts/demo-up.sh does), a tunnel host when the phone is off-LAN, or the public domain in prod.
#
# It is ALSO stamped into every issued credential as `protocol.statusBaseUrl`, the base the holder's
# receipt QR points at — and that copy is PERMANENT, unlike the 180s share token. So the backend
# REFUSES to stamp a base no phone could resolve (RFC-2606/6761 placeholders like `*.example`,
# `example.com/net/org`, `*.invalid`, `*.test`, and `localhost`); such a document simply carries no
# status page and every renderer says so, rather than printing a QR that goes nowhere.
# Leaving the placeholder below in place therefore means NO receipt QR. Set a real reachable host.
DEPLOYMENT_URL=https://gov.example.com
ISSUER_NAME=Example Competent Authority
ISSUER_DOMAIN=gov.example.com

# ---- On-chain addresses (from contracts/deployments/roax.json) -------------------------------
# These singular keys select THIS role stack's active generation. They do not configure the
# oversight scanner; that service watches its complete set via stacks/indexer/.env
# INDEXER_GENERATIONS.
# IssuerRegistry is the whitelist gate (read for the issuer-identity verification pillar).
ISSUER_REGISTRY_ADDR=0xAEE540350292E49A9AeDf19Dd4C3BAc6ABeE6c21

# --- issuer↔domain binding (docs/ISSUER_DOMAIN_BINDING.md) ---
# LINK 1 of the binding chain: the factory that KYC-gated an issuer clone into existence. Without it the
# binding reports "unavailable" — a domain claim on a contract that did not come from the DogTag factory
# proves nothing, so provenance is checked FIRST and the check cannot be skipped.
FACTORY_ADDR=0xED20269E3eBF0119739aaB5258741F3aEb49F140
# LINK 2: the additive registry holding each clone's on-chain domain claim. Read from the CHAIN, never
# from the credential document (whose issuer block is outside the Merkle root and can be relabelled).
# Deployed on ROAX 2026-07-28 (deployments/roax.json .IssuerDomainRegistry). Zero is still the honest
# setting for a deployment that has none: the binding then reports "unavailable" rather than claiming the
# issuer has no domain. Note the registry is EMPTY until a domain is bound, so a configured-but-unbound
# clone also reports "unavailable" - that is the same honest state, reached one link further along.
ISSUER_DOMAIN_REGISTRY_ADDR=0xD3B121FEaCde93b95288912EAdbB10824550FdBF
# LINK 3: the DoH endpoint for the SERVER-SIDE DNS lookup. Server-side deliberately: a browser cannot do
# raw DNS, and a client-side call would hand a public resolver the operator's IP plus which issuer they
# are inspecting. Empty disables resolution and every binding reports "could not check".
DNS_DOH_ENDPOINT=https://cloudflare-dns.com/dns-query
# Unified owner-hidden registry: the routing key stamped in each record's `protocol` block AND the
# submit target when this authority records a consent proof as a VERIFIER. It MUST name the same
# registry the vet/groomer stacks use (they call it VERIFICATION_REGISTRY_CONSENT_ADDR, accepted here
# as an alias) — the owner's phone resolves the registry independently from the on-chain
# ProtocolRegistry and REFUSES to prove if this deployment claims a different one. `GET /health`
# echoes the resolved value so a mismatch is eyeball-able instead of surfacing as a silent scan failure.
VERIFICATION_REGISTRY_ADDR=0xaBFd6f6E31780EBcB7ABd28A2a9bCfc9C8e6A77B

# ---- GENERATION 2 — NOT DEPLOYED, so DELIBERATELY UNSET ---------------------------------------
# Four keys above are what MOVE in the cutover. Their NAMES do not change; only their VALUES do, so
# there is deliberately nothing to add below: an extra variable here, empty or otherwise, would be
# config nothing reads, and a placeholder address would be worse than an absent one.
# S-13 repoints; S-14 deploys and records the addresses in contracts/deployments/roax.json.
#
#   ISSUER_REGISTRY_ADDR         -> ProviderRegistry                 (supersedes IssuerRegistry)
#   FACTORY_ADDR                 -> CloneProvenanceRouter            (NOT DogTagIssuerFactoryV2)
#   ISSUER_DOMAIN_REGISTRY_ADDR  -> ServiceDomainResolver            (supersedes IssuerDomainRegistry)
#   VERIFICATION_REGISTRY_ADDR   -> VerificationRegistryConsent V2
#
# FACTORY_ADDR is the one to get wrong. LINK 1 above reads the write-once rootIssuer[R] through it,
# and the ROUTER is what resolves roots across BOTH generations, oldest-generation-first. Point it at
# DogTagIssuerFactoryV2 and every generation-1 root resolves to address(0) — which surfaces as an
# indeterminate issuer-whitelist pillar, not as an error, so nothing tells you.
#
# ORDER (registry plan section 2): C-6 must migrate this authority's VERIFY: relayer capability into
# the new core BEFORE this repoint. restrictToWhitelistedRelayers defaults true, so a stack pointed
# at the V2 registry with an unmigrated relayer answers !verify-wl on every verification.
#
# VERIFICATION_REGISTRY_ADDR additionally has to move IN STEP with the vet/groomer stacks and with
# the ProtocolRegistry anchor: the owner's phone resolves the registry independently and REFUSES to
# prove when this deployment claims a different one. `GET /health` echoes the resolved value.
#
# Inventory + checker: scripts/check-cutover-consumers.sh. Full record: docs/CLIENT_REPOINT.md.

# DogTagIssuer clones this authority anchors roots to. These are per-record-type clones deployed
# via the existing DogTagIssuerFactory (an OPS step — no contract change). Leave zero to disable
# on-chain issuance for that record type (build+persist still works via dry_run). See ROLE_APPS.md.
#
# A clone MUST be bound to the SAME IssuerRegistry this stack uses (ISSUER_REGISTRY_ADDR above):
# DogTagIssuer.issue is onlyWhitelisted against the clone's OWN registry(), so a clone bound to a
# superseded registry fails closed (NotWhitelisted) even after a correct whitelistFor on the registry
# the stack reads - and nothing before the first issuance reveals it. The GOV_SIGNER_KEY address must be
# whitelisted there for keccak256(<recordType>).
#
# LIVE on ROAX (chainId 135), from contracts/deployments/roax.json → government_clones: deployed via
# DogTagIssuerFactory.createIssuer on factory 0xED20269E with business == the governance signer
# 0x8E27E117663bc6B65F82cC6E98412b4003e6F4A2 (the factory Ownable owner). Verified on-chain: isClone
# true, registry() == 0xAEE54035…, recordType() == keccak256("TRAVEL_CLEARANCE").
# Do NOT use the earlier 0x8e276BD4… / 0xe30A1739… pair: they are bound to the RETIRED IssuerRegistry
# 0x5d86e4CF… and are quarantined in the ledger as `government_clones_deadRegistry_legacy`.
TRAVEL_CLEARANCE_ISSUER_ADDR=0xB5D6654d8B29096C8fcf71d24bbe6f6de86c5F9F
# EU_HEALTH_CERT has NO clone on the fresh set yet. Leave it EMPTY until one is deployed
# (scripts/demo-provision-government.sh, or createIssuer directly): unset means the API reports the
# issuer as null and /issue falls back to dry_run, instead of anchoring somewhere wrong.
EU_HEALTH_CERT_ISSUER_ADDR=

# ---- Government signer (32-byte secp256k1 private key, 0x-optional hex) -----------------------
# Required to anchor roots on-chain (DogTagIssuer.issue). This address must hold the record type's
# issuance whitelist (IssuerRegistry.whitelistFor, granted by the protocol admin) and be funded
# with PLASMA gas. Reads (verify) work without it. NEVER commit a real key.
#
# It is ALSO the relayer for the owner-hidden verify flow, which needs a SEPARATE grant: the
# `VERIFY:<purpose>` whitelist namespace (`whitelistFor(keccak256(abi.encode("VERIFY:", purpose)),
# signer)`), granted through the admin apply→approve flow. Holding the issuance roles above does NOT
# imply it. Until it is granted, `POST /verify/session/start` refuses with 403 "relayer not
# whitelisted for this purpose" and the portal says so in the UI; issuance and the paste-JSON verify
# are unaffected. The portal offers the `travel_check` purpose (see government_api::app::VERIFY_PURPOSES).
GOV_SIGNER_KEY=

# ---- Demo toggle (STORE only) ----------------------------------------------------------------
# GOV_DEMO_MODE=1 uses the in-memory MemStore (no Mongo) and enables the well-known demo API token.
# It does NOT select a simulated chain. Leave UNSET in production.
# GOV_DEMO_MODE=1
# VITE_DEMO_MODE=1 is the PORTAL-side flag (repo-wide convention, set by scripts/demo-up.sh). It
# only enables demo affordances such as the Issue page's "Fill demo data" button; it changes nothing
# about issuance itself. Leave UNSET in production.
# VITE_DEMO_MODE=1

# ---- Chain backend ---------------------------------------------------------------------------
# Which chain surface the service talks to. This is deliberately INDEPENDENT of GOV_DEMO_MODE:
#   live (default) - real JSON-RPC node at ROAX_RPC. Reads are real; writes cost real gas.
#   mem            - in-process simulation. NOTHING is broadcast and nothing survives a restart.
# Simulation is opt-in only, so no deployment can end up on a fake chain by accident. /health
# reports which one is active (backend="live"|"simulated", and chainId=null when simulated), so an
# operator can always tell them apart at a glance.
# GOV_CHAIN_BACKEND=live

# ---- Hardening (production values) -----------------------------------------------------------
# CORS allowlist (comma-separated origins). Unset => permissive (demo only).
CORS_ALLOW_ORIGINS=https://gov.example.com
# Bearer token gating the record MUTATION endpoints (PATCH /v1/records/:root and
# POST /v1/records/:root/revoke). Reads/verify/issue stay open. Unset in production => mutations
# fail closed (503). In demo mode an unset token defaults to `dogtag-gov-demo-token` (the portal's
# VITE_GOV_API_TOKEN falls back to the same value).
GOV_API_TOKEN=

# ---- Oversight indexer (govarch PR-5: the Oversight console's data layer) ---------------------
# The Oversight page consumes the standalone oversight indexer (stacks/indexer, port 46001) UNSCOPED:
# it sees EVERY issuer's on-chain activity (cross-issuer government oversight), joined to this
# authority's OWN issued credentials. Set the indexer base + the UNSCOPED oversight bearer (an
# INDEXER_SCOPES entry with `unscoped:true`). The /v1/oversight/* surfaces are gated by GOV_API_TOKEN;
# when the indexer is unset they return 503 (a "indexer not connected" state), backend otherwise fine.
# INDEXER_API_BASE=http://indexer:46001
# INDEXER_OVERSIGHT_TOKEN=   # the indexer's unscoped:true token (GOV_INDEXER_TOKEN is an alias)

# ---- Caddy TLS reverse-proxy -----------------------------------------------------------------
DOMAIN=gov.example.com
