# ==============================================================================================
# DogTag — GROOMER stack env (REMOTE / PRODUCTION template). Copy to `.env` and fill in.
# ----------------------------------------------------------------------------------------------
# Local/demo uses scripts/demo-up.sh (MemStore, DNS_CHECK=skip, demo passwords) — it does NOT read
# this file. This file is the REMOTE/production template, consumed by
# stacks/groomer/docker-compose.yml (and scripts/remote-up.sh). To target a DIFFERENT chain, change
# ROAX_RPC + CHAIN_ID + the *_ADDR addresses below — no code edits.
# The groomer backend IS the vet-api binary run with BUSINESS_TYPE=groomer.
# ==============================================================================================
BUSINESS_TYPE=groomer

# ---- Chain (config-only swap to a different chain) -------------------------------------------
ROAX_RPC=https://devrpc.roax.net
CHAIN_ID=135

# ---- Persistent store (Mongo) ----------------------------------------------------------------
# Custody (age-encrypted seed) + records live here — BACK UP the Mongo data volume. The api
# fail-closes (refuses to boot) if it cannot connect.
MONGO_URI=mongodb://mongo:27017/dogtag
MONGO_DB=dogtag

# ---- Listener ports --------------------------------------------------------------------------
PORT=43618
# ADMIN_PORT defaults to PORT+1; the /admin/* router binds here when ADMIN_LOOPBACK_ONLY=1.
# ADMIN_PORT=43619

# ---- This deployment's public identity --------------------------------------------------------
DEPLOYMENT_URL=https://groomer.example.com
DEPLOYMENT_DOMAIN=groomer.example.com
ISSUER_NAME=Example Grooming Salon
ISSUER_DOMAIN=groomer.example.com

# ---- On-chain addresses (from contracts/deployments/roax.json) -------------------------------
# A groomer is typically a VERIFIER, so the issuer-clone addr may stay zero.
ISSUER_REGISTRY_ADDR=0x5d86e4CF98A34Ae0576F190F8d209c2943a9C79c
VERIFICATION_REGISTRY_CONSENT_ADDR=0xb9B313C17fD8725Bb50A7f41121ac4Cf5F4fec87
VACCINATION_ISSUER_ADDR=0x0000000000000000000000000000000000000000

# ---- Owner-hidden custodial issuance (POST /profiles/issue/custodial-bind) --------------------
# Present because the groomer runs the SAME vet-api binary; a pure verifier leaves BOTH unset.
# The device folds the profile root R from its own wallet seed and
# POSTs only R; the backend anchors it with issue(R) then seals it with mintCustodial(dogTagId, R),
# so no owner wallet ever reaches the calldata. This is the sole profile issuance path.
# Required as a pair. If either is unset or malformed, the route fails closed with 503 —
# checked BEFORE the one-time bind token is consumed, so a half-wired stack never burns an
# operator's QR.
# SBT_CONSENT_ADDR — the DogTagSBTConsent mint target. The signer must hold ISSUER_ROLE on it.
# PROFILE_ISSUER_ADDR — a real factory-deployed DogTagIssuer clone to anchor roots into, so
#   rootIssuer[R] resolves. It must not be the SBT: issue(R) sent to the SBT reverts. The signer
#   must be whitelisted for the clone's recordType.
# SBT_CONSENT_ADDR=
# PROFILE_ISSUER_ADDR=

# ---- Owner-hidden consent verification (POST /v1/verify/consent) ------------------------------
# The device proves consent against consent.circom and the backend relays the proof through
# VERIFICATION_REGISTRY_CONSENT_ADDR. The relayer (custody account 0) must be whitelisted for the
# purpose it submits. An unset or malformed registry address fails closed with 503.

# ---- Hardening (production values) -----------------------------------------------------------
DNS_CHECK=doh                 # real issuer-domain legitimacy via Cloudflare DoH (demo uses `skip`)
CONFIRMATIONS=2               # reorg-safety at /credentials/confirm (demo uses 1)
ADMIN_LOOPBACK_ONLY=1         # bind /admin/* custody routes to 127.0.0.1:ADMIN_PORT only
CORS_ALLOW_ORIGINS=https://groomer.example.com

# ---- Secrets (generate strong values — do NOT reuse the demo defaults) -----------------------
OPERATOR_PASSWORD=        # generate: openssl rand -hex 32
ADMIN_PASSWORD=           # generate: openssl rand -hex 32
CENTRAL_HMAC_SECRET=      # generate: openssl rand -hex 32  (must match central's CENTRAL_HMAC_SECRET)

# ---- Caddy TLS reverse-proxy -----------------------------------------------------------------
# Public hostname Caddy issues a Let's Encrypt cert for. Needs a DNS A record + open ports 80/443.
DOMAIN=groomer.example.com

# ---- Central registry wiring -----------------------------------------------------------------
BUSINESS_ID=biz-groomer-local
CENTRAL_BASE_URL=https://api.dogtag.io

# ---- Oversight indexer (govarch PR-5: the Traceability portal's data layer) -------------------
# The Traceability page consumes the standalone oversight indexer (stacks/indexer, port 46001),
# joining THIS business's own on-chain verification/checkin activity to its DB records. Set the
# indexer base + this business's SCOPED bearer (an INDEXER_SCOPES entry bound to this signer/clone).
# When unset, /trace/* returns 503 and the page shows a "indexer not connected" state. Scoping is
# enforced by the indexer (this token only ever sees this business's events) AND re-checked here.
# INDEXER_API_BASE=http://indexer:46001
# INDEXER_SCOPED_TOKEN=   # this business's scoped INDEXER_SCOPES token (INDEXER_TOKEN is an alias)

# ---- Google Calendar OAuth (Phase 7) ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
