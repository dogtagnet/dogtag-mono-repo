# ==============================================================================================
# DogTag — OVERSIGHT INDEXER stack env (REMOTE / PRODUCTION template). Copy to `.env` and fill in.
# ----------------------------------------------------------------------------------------------
# The indexer scans the ROAX factory / registry / DogTagIssuer-clone / VerificationRegistry event
# logs into a non-PII, queryable index and serves the scope-enforced query API: the UNSCOPED
# government oversight feed + per-signer/clone SCOPED views for vet/groomer. It is a SEPARATE
# deployable (own docker-compose, own Mongo) — see docs/ROLE_APPS.md + AGENTS.md.
#
# Local/demo: set INDEXER_DEMO_MODE=1 (scripted in-memory MemLogSource + MemStore, no node, no
# Mongo; ships two well-known demo tokens). This file is the REMOTE/production template. To target a
# DIFFERENT chain, change ROAX_RPC + CHAIN_ID + the *_ADDR addresses below — no code edits.
#
# A demo indexer SAYS SO: /health and /v1/status report `"simulated": true`, `"backend": "simulated"`
# and `"chainId": null` (the scripted blocks, roots and txUrl links are fabricated - that feed is on no
# network, so it never echoes the CHAIN_ID below). A live one reports `"simulated": false`,
# `"backend": "live"` and the real id. Curl /health if you are ever unsure which you are looking at.
# ==============================================================================================

# ---- Chain (config-only swap to a different chain) -------------------------------------------
ROAX_RPC=https://devrpc.roax.net
CHAIN_ID=135

# ---- Persistent store (Mongo, internal to the compose network only) --------------------------
MONGO_URI=mongodb://mongo:27017/dogtag
MONGO_DB=dogtag

# ---- Listener port ---------------------------------------------------------------------------
PORT=46001

# ---- Watched contracts (from contracts/deployments/roax.json) --------------------------------
FACTORY_ADDR=0xED20269E3eBF0119739aaB5258741F3aEb49F140
ISSUER_REGISTRY_ADDR=0xAEE540350292E49A9AeDf19Dd4C3BAc6ABeE6c21
# The sole verification registry emits the owner-hidden, subject-less `Verified` event.
VERIFICATION_REGISTRY_CONSENT_ADDR=0xaBFd6f6E31780EBcB7ABd28A2a9bCfc9C8e6A77B
# DogTagIssuer clones known from the deployment record, so issuances anchored BEFORE the indexer's
# first run are still attributed to a known clone (discovered IssuerCreated clones extend this set
# automatically). Comma-separated. Defaults to the same government + demo clones if unset.
# These are the clones on the FRESH owner-hidden set (contracts/deployments/roax.json): the government
# TRAVEL_CLEARANCE clone plus the two demo clones. Do NOT re-add 0x8e276BD4… / 0xe30A1739… - they are
# bound to the RETIRED IssuerRegistry and quarantined as government_clones_deadRegistry_legacy, and
# EU_HEALTH_CERT has no clone on the fresh set to seed.
SEED_CLONES=0xB5D6654d8B29096C8fcf71d24bbe6f6de86c5F9F,0x0e56Ae2e1ef684d3e90d7699B981C6B76df922bf,0x1456f93f7376789c46408CC4616751eB853edD9A

# ---- Scan tuning -----------------------------------------------------------------------------
# First block to scan on a FRESH index (the factory/registry deploy block; 0 = genesis). Once the
# finalized-watermark cursor is persisted, restarts resume from it and ignore this.
START_BLOCK=0
# Finality watermark: the indexer prefers the chain's `finalized` block tag (true PoS finality —
# ROAX exposes it). CONFIRMATIONS is the FALLBACK only — if a node ever lacks the tag, blocks below
# (head - CONFIRMATIONS) are treated as final instead. Events at/below the watermark are `finalized`
# (immutable); the pending range above it is re-derived each tick (idempotent, keyed by txHash:logIndex).
CONFIRMATIONS=5
# Max block span per eth_getLogs request (RPC-friendly chunking).
CHUNK_SIZE=5000
# Seconds between ingest ticks.
POLL_INTERVAL_SECS=12

# ---- Query API paging + explorer -------------------------------------------------------------
DEFAULT_PAGE_LIMIT=100
MAX_PAGE_LIMIT=1000
EXPLORER_BASE=https://explorer.roax.net

# ---- Scope tokens (SERVER-SIDE access control — REQUIRED in production) -----------------------
# JSON array mapping bearer tokens to a scope. `unscoped:true` = government oversight (every event).
# Otherwise the token sees ONLY events whose acting signer ∈ signers OR whose clone ∈ clones.
# WITHOUT this (and not in demo mode) every query 401s (fail-closed). Example:
# INDEXER_SCOPES=[{"token":"REPLACE_gov_oversight","label":"government-oversight","unscoped":true},{"token":"REPLACE_seaport_paw","label":"The Seaport Paw","signers":["0xabc…"],"clones":["0xdef…"]}]
INDEXER_SCOPES=

# ---- Signer→business directory (naming, optional) --------------------------------------------
# Operator-authoritative static names: JSON {address: name}. Always applied; works offline.
# INDEXER_DIRECTORY={"0x119f…":"DogTag Government Authority"}
INDEXER_DIRECTORY=
# Optional admin-API enrichment: the indexer periodically joins signer addresses to business names
# from the admin business directory (reads /v1/businesses [public] + /v1/issuer-applications [needs
# the admin token]). Doctrine: business identity only — never PII.
ADMIN_API_BASE=
ADMIN_API_TOKEN=

# ---- Demo toggle (local only) ----------------------------------------------------------------
# INDEXER_DEMO_MODE=1
