# ==============================================================================================
# DogTag — OVERSIGHT INDEXER stack env (REMOTE / PRODUCTION template). Copy to `.env` and fill in.
# ----------------------------------------------------------------------------------------------
# The indexer scans the ROAX factory / registry / DogTagIssuer-clone / VerificationRegistry event
# logs into a non-PII, queryable index and serves the scope-enforced query API: the UNSCOPED
# government oversight feed + per-signer/clone SCOPED views for vet/groomer. It is a SEPARATE
# deployable (own docker-compose, own Mongo) — see docs/ROLE_APPS.md + AGENTS.md.
#
# Local/demo: set INDEXER_DEMO_MODE=1 (scripted in-memory MemLogSource + MemStore, no node, no
# Mongo; ships two well-known demo tokens). This file is the REMOTE/production template. To target a
# DIFFERENT chain, change ROAX_RPC + CHAIN_ID + INDEXER_GENERATIONS below — no code edits.
#
# A demo indexer SAYS SO: /health and /v1/status report `"simulated": true`, `"backend": "simulated"`
# and `"chainId": null` (the scripted blocks, roots and txUrl links are fabricated - that feed is on no
# network, so it never echoes the CHAIN_ID below). A live one reports `"simulated": false`,
# `"backend": "live"` and the id you set in CHAIN_ID below — operator-asserted, never checked against
# the node, so keep CHAIN_ID and ROAX_RPC on the same network yourself. Curl /health if you are ever
# unsure which of the two you are looking at.
# ==============================================================================================

# ---- Chain (config-only swap to a different chain) -------------------------------------------
ROAX_RPC=https://devrpc.roax.net
CHAIN_ID=135

# ---- Persistent store (Mongo, internal to the compose network only) --------------------------
MONGO_URI=mongodb://mongo:27017/dogtag
MONGO_DB=dogtag

# ---- Listener port ---------------------------------------------------------------------------
PORT=46001

# ---- Watched contract generations (from contracts/deployments/roax.json) ----------------------
# Atomic JSON array: each object owns its exact factory / IssuerRegistry / owner-hidden
# VerificationRegistryConsent triple and the pre-existing clones that factory created. Add one object
# BEFORE a new generation emits. The lowercase factory address is the immutable generation id stamped
# on every event and reported by /v1/status.watchedGenerations.
#
# The role-specific anti-spoof gate accepts an event only from the matching address in one of these
# objects (or, for RootIssued/RootRevoked, a seed/discovered clone owned by one). Malformed, empty, or
# ambiguous sets fail startup; do not reuse an emitter or seed clone across objects.
#
# seedClones catches issuances anchored before this indexer's first scan; later IssuerCreated events
# extend the right generation automatically. This current object seeds the fresh-set government
# TRAVEL_CLEARANCE clone plus the two demo clones. Do NOT add 0x8e276BD4… / 0xe30A1739…: they are
# retained deployment history bound to a retired IssuerRegistry, not live generations to watch.
INDEXER_GENERATIONS=[{"factory":"0xED20269E3eBF0119739aaB5258741F3aEb49F140","issuerRegistry":"0xAEE540350292E49A9AeDf19Dd4C3BAc6ABeE6c21","verificationRegistry":"0xaBFd6f6E31780EBcB7ABd28A2a9bCfc9C8e6A77B","seedClones":["0xB5D6654d8B29096C8fcf71d24bbe6f6de86c5F9F","0x0e56Ae2e1ef684d3e90d7699B981C6B76df922bf","0x1456f93f7376789c46408CC4616751eB853edD9A"]}]

# ---- GENERATION 2 — NOT DEPLOYED, so DELIBERATELY UNSET ---------------------------------------
# This service is the ONE whose repoint is an ADDITION rather than a value swap, because the setting
# is a LIST: generation 1 keeps its object forever (its 19 anchored roots and their revocations stay
# in the feed), and generation 2 gets a SECOND object beside it. Replacing the object instead of
# appending would drop the entire pre-cutover history out of oversight.
#
# S-14 appends, with the generation-2 triple:
#   factory              = DogTagIssuerFactoryV2
#   issuerRegistry       = ProviderRegistry                (supersedes IssuerRegistry)
#   verificationRegistry = VerificationRegistryConsent V2
#   seedClones           = []                              (a fresh factory has created none yet)
#
# NOTE the factory member is the FACTORY, not the CloneProvenanceRouter — the opposite of the vet /
# groomer / government stacks. This is an EMITTER allowlist keyed by who signed the log, and the
# router emits nothing; a router address here would silently match no event ever.
#
# THE ORDER IS NOT ADVISORY. This must be appended and the service restarted BEFORE generation 2
# emits its first event (plan C-9, ahead of C-11). The anti-spoof gate drops an unrecognised emitter
# SILENTLY — no error, no counter — so a late edit does not produce a failure, it produces an
# oversight feed that reads as merely quiet. /v1/status.watchedGenerations reports the exact set in
# force, which is how you check rather than assume.
#
# START_BLOCK below does NOT help you recover: once the finalized-watermark cursor is persisted,
# restarts resume from it. Appending a generation after its events occurred needs a deliberate fresh
# rebuild and rescan.
#
# Inventory + checker: scripts/check-cutover-consumers.sh. Full record: docs/CLIENT_REPOINT.md.

# ---- Scan tuning -----------------------------------------------------------------------------
# First block to scan on a FRESH index (at/before the OLDEST watched generation's deploy block; 0 =
# genesis). Once the finalized-watermark cursor is persisted, restarts resume from it and ignore this.
# Adding a generation after its events occurred therefore requires a deliberate fresh rebuild/rescan.
START_BLOCK=0
# Finality watermark: the indexer prefers the chain's `finalized` block tag (true PoS finality —
# ROAX exposes it). CONFIRMATIONS is the FALLBACK only — if a node ever lacks the tag, blocks below
# (head - CONFIRMATIONS) are treated as final instead. Events at/below the watermark are `finalized`
# (immutable); the pending range above it is re-derived each tick (idempotent, keyed by txHash:logIndex).
CONFIRMATIONS=5
# Max block span per eth_getLogs request (RPC-friendly chunking).
CHUNK_SIZE=5000
# Seconds between ingest ticks.
POLL_INTERVAL_SECS=12

# ---- Query API paging + explorer -------------------------------------------------------------
# These bounds apply to both the bearer-gated oversight routes and the public provider directory.
# GET /v1/businesses pages source-order name/kind results. POST /v1/businesses/nearest pages
# server-distance-ordered results; its exact caller position is body-only,
# ephemeral, and never logged or persisted. `kind` is repeatable (`kind=vet&kind=groomer`, OR
# semantics; repeatable `type` is its compatibility alias); no kind means every published kind.
DEFAULT_PAGE_LIMIT=100
MAX_PAGE_LIMIT=1000
EXPLORER_BASE=https://explorer.roax.net

# ---- Scope tokens (SERVER-SIDE access control — REQUIRED in production) -----------------------
# JSON array mapping bearer tokens to a scope. `unscoped:true` = government oversight (every event).
# Otherwise the token sees ONLY events whose acting signer ∈ signers OR whose clone ∈ clones.
# WITHOUT this (and not in demo mode) every query 401s (fail-closed). Example:
# INDEXER_SCOPES=[{"token":"REPLACE_gov_oversight","label":"government-oversight","unscoped":true},{"token":"REPLACE_seaport_paw","label":"The Seaport Paw","signers":["0xabc…"],"clones":["0xdef…"]}]
INDEXER_SCOPES=

# ---- Signer→business directory (naming, optional) --------------------------------------------
# Operator-authoritative static names: JSON {address: name}. Always applied; works offline.
# INDEXER_DIRECTORY={"0x119f…":"DogTag Government Authority"}
INDEXER_DIRECTORY=
# Interim provider-list source + optional signer-name enrichment. ADMIN_API_BASE makes the indexer
# periodically read the admin's complete public /v1/businesses response, which backs the indexer's own
# public GET /v1/businesses. Without one successful read that route honestly returns 503, not an empty
# list. ADMIN_API_TOKEN is needed only for /v1/issuer-applications and the signer→business naming join;
# the provider rows themselves are public business identity. Doctrine: business identity only — never
# owner/role PII. S-10 may replace the interim provider source with the on-chain registry.
ADMIN_API_BASE=
ADMIN_API_TOKEN=

# ---- Demo toggle (local only) ----------------------------------------------------------------
# INDEXER_DEMO_MODE=1
