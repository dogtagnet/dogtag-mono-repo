# Admin portal env (copy to .env.local)

# Central admin API base used by the central client (via the Vite /api proxy by default).
VITE_CENTRAL_API_BASE=/api

# Dev proxy target for /api (the central backend). Defaults to http://localhost:39742.
VITE_CENTRAL_API_PROXY=http://localhost:39742

# Reown Cloud projectId for WalletConnect (the admin portal uses the shared wallet provider for
# theming/StatusPanel parity; a placeholder is fine if you don't connect a wallet here).
VITE_REOWN_PROJECT_ID=REPLACE_WITH_REOWN_PROJECT_ID

# Optional: deployment URL.
VITE_DEPLOYMENT_URL=http://localhost:39741

# Guarded default for direct on-chain reads. Users may save another same-chain peer in Settings; a
# bad custom peer falls back here after this default is independently chain-checked. This changes
# neither the central/indexer APIs nor the provider used by an injected/WalletConnect wallet.
VITE_ROAX_RPC=https://devrpc.roax.net

# Deployed ROAX contract addresses (contracts/deployments/roax.json). The whitelist viewer reads
# IssuerRegistry.isWhitelistedFor(bytes32,address) directly via viem when the registry is set;
# otherwise it falls back to deriving state from approved issuer-applications.
VITE_ISSUER_REGISTRY_ADDR=0xAEE540350292E49A9AeDf19Dd4C3BAc6ABeE6c21

# Demo mode (default OFF). When set to 1 (or "true"), the portal prefills forms, shows
# "Fill demo data" / "Demo (vet/groomer)" buttons, and autofills the demo admin password /
# passphrase. NEVER enable in production — in demo mode the vet genesis seed is briefly stashed
# in sessionStorage to auto-fill the confirm step. Unset = secure production behavior.
# VITE_DEMO_MODE=1

# Verification bench (admin-only): the factory that anchors a credential to its issuing clone. Unset
# falls back to the SDK's deployed default -- the anchor is never silently disabled.
# VITE_DOGTAG_ISSUER_FACTORY_ADDR=0xED20269E3eBF0119739aaB5258741F3aEb49F140

# IssuerDomainRegistry, for the bench's issuer-domain check. NO fallback by design: unset makes that
# one check report itself unavailable rather than read an address the next contract round may move.
# Deployed on ROAX 2026-07-28 (deployments/roax.json .IssuerDomainRegistry). Set it, or the bench's
# on-chain-domain row reports "could not run" no matter what the issuer has published.
VITE_ISSUER_DOMAIN_REGISTRY_ADDR=0xD3B121FEaCde93b95288912EAdbB10824550FdBF

# ---- GENERATION 2 — NOT DEPLOYED, so DELIBERATELY UNSET ---------------------------------------
# Three keys above are what MOVE in the cutover. Their NAMES do not change; only their VALUES do, so
# there is deliberately nothing to add below: an extra variable here, empty or otherwise, would be
# config nothing reads, and a placeholder address would be worse than an absent one.
# S-13 repoints; S-14 deploys and records the addresses in contracts/deployments/roax.json.
#
#   VITE_ISSUER_REGISTRY_ADDR         -> ProviderRegistry            (READ-ONLY here - see below)
#   VITE_DOGTAG_ISSUER_FACTORY_ADDR   -> CloneProvenanceRouter       (NOT DogTagIssuerFactoryV2)
#   VITE_ISSUER_DOMAIN_REGISTRY_ADDR  -> ServiceDomainResolver       (supersedes IssuerDomainRegistry)
#
# BOTH registry-ish keys here move OPPOSITE to their backend namesakes in stacks/admin/.env.example,
# and both pairs differ only by the VITE_ prefix - so check which side you are on before editing.
#
# VITE_ISSUER_REGISTRY_ADDR is READ-ONLY: packages/ui's ISSUER_REGISTRY_ABI declares isWhitelistedFor
# and nothing else, and the portal's grant/revoke buttons POST to admin-api rather than building
# calldata here. ProviderRegistry implements that read, so this one moves. The BACKEND
# ISSUER_REGISTRY_ADDR does NOT move: it builds whitelistFor/delistFor calldata, which
# ProviderRegistry does not implement at all, so it stays on generation 1 through C-12.
#
# VITE_DOGTAG_ISSUER_FACTORY_ADDR is the BENCH's anchor read (rootIssuer), so it takes the ROUTER -
# the opposite of this same stack's BACKEND FACTORY_ADDR in stacks/admin/.env.example, which is a
# createIssuer WRITE target and takes DogTagIssuerFactoryV2. Two variables named after the same
# contract that move to two different addresses; check which side you are on before editing either.
#
# Note this one commented-out key FALLS BACK to the SDK default in packages/ui when unset, so leaving
# it unset after the cutover does not disable the check — it silently keeps reading generation 1.
# VITE_ISSUER_DOMAIN_REGISTRY_ADDR has no fallback and fails closed instead. Different failure modes
# on adjacent lines; the fallback one is the one that can lie.
#
# Inventory + checker: scripts/check-cutover-consumers.sh. Full record: docs/CLIENT_REPOINT.md.
