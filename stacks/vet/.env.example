# ==============================================================================================
# DogTag — VET stack env (REMOTE / PRODUCTION template). Copy to `.env` and fill in.
# ----------------------------------------------------------------------------------------------
# Local/demo uses scripts/demo-up.sh (MemStore, demo passwords) — it does NOT read
# this file. This file is the REMOTE/production template, consumed by stacks/vet/docker-compose.yml
# (and scripts/remote-up.sh). To target a DIFFERENT chain, change ROAX_RPC + CHAIN_ID + the *_ADDR
# addresses below — no code edits.
# ==============================================================================================

# ---- Chain (config-only swap to a different chain) -------------------------------------------
ROAX_RPC=https://devrpc.roax.net
CHAIN_ID=135

# ---- Persistent store (Mongo) ----------------------------------------------------------------
# Custody (age-encrypted seed) + records live here — BACK UP the Mongo data volume. The api
# fail-closes (refuses to boot) if it cannot connect. In compose, MONGO_URI is set to the internal
# `mongo` service; override here only for an external/managed Mongo.
MONGO_URI=mongodb://mongo:27017/dogtag
MONGO_DB=dogtag

# ---- Listener ports --------------------------------------------------------------------------
PORT=41874
# ADMIN_PORT defaults to PORT+1; the /admin/* router binds here when ADMIN_LOOPBACK_ONLY=1.
# ADMIN_PORT=41875

# ---- This deployment's public identity (DNS-TXT issuer binding + JWT issuer claim) -----------
DEPLOYMENT_URL=https://vet.example.com
DEPLOYMENT_DOMAIN=vet.example.com
ISSUER_NAME=Example Veterinary Clinic
ISSUER_DOMAIN=vet.example.com

# ---- On-chain addresses (from contracts/deployments/roax.json) -------------------------------
# These singular keys select THIS role stack's active generation. They do not configure the
# oversight scanner; that service watches its complete set via stacks/indexer/.env
# INDEXER_GENERATIONS.
ISSUER_REGISTRY_ADDR=0xAEE540350292E49A9AeDf19Dd4C3BAc6ABeE6c21
# FACTORY_ADDR — the DogTagIssuerFactory. REQUIRED for BOTH verifying routes — POST /verify/credential
# AND POST /import/pull (the SDK-backed third-party verify) — to evaluate the
# issuer-whitelist pillar at all: its write-once rootIssuer[R] is what tells this deployment which
# clone actually issued a credential, instead of believing the document's own issuer.documentStore
# (which sits OUTSIDE the Merkle root and is therefore attacker-controlled). Left unset, that pillar
# reports itself `unavailableNoFactoryConfigured` and a forged document is refused by nothing but
# integrity — so treat this as a security setting, not a convenience one.
FACTORY_ADDR=0xED20269E3eBF0119739aaB5258741F3aEb49F140
VERIFICATION_REGISTRY_CONSENT_ADDR=0xaBFd6f6E31780EBcB7ABd28A2a9bCfc9C8e6A77B
VACCINATION_ISSUER_ADDR=0x0000000000000000000000000000000000000000

# ---- GENERATION 2 — NOT DEPLOYED, so DELIBERATELY UNSET ---------------------------------------
# The three keys above are what MOVE in the cutover. Their NAMES do not change; only their VALUES
# do, so there is deliberately nothing to add below: an extra variable here, empty or otherwise,
# would be config nothing reads, and a placeholder address would be worse than an absent one.
# S-13 repoints; S-14 deploys and records the addresses in contracts/deployments/roax.json.
#
#   ISSUER_REGISTRY_ADDR                -> DOES NOT MOVE AT C-9              (BLOCKED - see below)
#   FACTORY_ADDR                        -> CloneProvenanceRouter            (NOT DogTagIssuerFactoryV2)
#   VERIFICATION_REGISTRY_CONSENT_ADDR  -> VerificationRegistryConsent V2
#
# ISSUER_REGISTRY_ADDR IS BLOCKED, and pointing it at ProviderRegistry breaks this stack in two ways
# at once. ProviderRegistry.isWhitelistedFor branches on msg.sender: an attached service caller gets
# its own grant, and EVERY OTHER caller gets the orthogonal VERIFY-key capability mapping. Every read
# here is a plain eth_call with no `from`, so msg.sender is 0x0 and that second branch always runs.
# The VERIFY-key reads (routes.rs:1463, verify.rs:505) therefore still work, but every RECORD-TYPE-key
# read returns a definite false for a genuine issuer signer:
#   - routes.rs:1258 is the mandatory issuer-whitelist pillar, which treats a definite false as an
#     AUTHENTICITY FAILURE - so genuine credentials are refused as forged.
#   - routes.rs:549 and :658 are the issuance preflight, so this vet's OWN whitelisted signer is
#     refused and issuance stops.
# One value serves both key shapes in this same process, so there is nothing to split here: the whole
# variable stays on generation 1 until the record-type callers migrate to the service-scoped
# isRecognizedIssuer(service, signer) - a code change, not a repoint (docs/ISSUER_V2_OWNERSHIP.md #8).
# Separately, ProviderRegistry implements neither whitelistFor nor delistFor, which is why the admin
# console's identically-named variable is blocked too. The governing condition behind both: an address
# may be repointed only when the successor answers THE SAME QUESTION FOR THE SAME INPUTS - a matching
# selector is not evidence of that, and a confident wrong answer is worse than a revert.
#
# FACTORY_ADDR is the one to get wrong. This stack reads the write-once rootIssuer[R] through it, and
# the ROUTER is what resolves roots across BOTH generations, oldest-generation-first. Point it at
# DogTagIssuerFactoryV2 and every generation-1 root resolves to address(0) — which surfaces as an
# indeterminate issuer-whitelist pillar, not as an error, so nothing tells you.
#
# ORDER (registry plan section 2): C-6 must migrate this stack's VERIFY: relayer capability into the
# new core BEFORE this repoint. restrictToWhitelistedRelayers defaults true, so a stack pointed at
# the V2 registry with an unmigrated relayer answers !verify-wl on every verification.
#
# Inventory + checker: scripts/check-cutover-consumers.sh. Full record: docs/CLIENT_REPOINT.md.

# ---- Owner-hidden custodial issuance (POST /profiles/issue/custodial-bind) --------------------
# The device folds the profile root R from its own wallet seed and
# POSTs only R; the vet anchors it with issue(R) then seals it with mintCustodial(dogTagId, R), so
# no owner wallet ever reaches the calldata. This is the sole profile issuance path.
# Required as a pair. If either is unset or malformed, the route fails closed with 503 —
# checked BEFORE the one-time bind token is consumed, so a half-wired stack never burns an
# operator's QR.
# SBT_CONSENT_ADDR — the DogTagSBTConsent mint target. The vet signer must hold ISSUER_ROLE on it.
# PROFILE_ISSUER_ADDR — a real factory-deployed DogTagIssuer clone to anchor roots into, so
#   rootIssuer[R] resolves. It must not be the SBT: issue(R) sent to the SBT reverts. The vet signer
#   must be whitelisted for the clone's recordType.
SBT_CONSENT_ADDR=0xBEbc45A838643D27004827b797b30A464b2b02c0
# PROFILE_ISSUER_ADDR=

# ---- Owner-hidden consent verification (POST /v1/verify/consent) ------------------------------
# The device proves consent against consent.circom and the vet relays the proof through
# VERIFICATION_REGISTRY_CONSENT_ADDR. The relayer (custody account 0) must be whitelisted for the
# purpose it submits. An unset or malformed registry address fails closed with 503.

# ---- Hardening (production values) -----------------------------------------------------------
# DNS_CHECK is RETIRED and ignored (the process warns if it is set). It used to select a checker,
# and `skip` installed one that returned an unconditional pass — a fabricated result on the gate
# that decides whether an organisation is legitimate enough to whitelist. Every deployment now
# performs a real Cloudflare-DoH lookup, and the issuer gate is ADVISORY: it never blocks, but a
# non-verified observation needs the admin's explicit `proceedWithoutDns` and is persisted.
# See docs/ISSUER_DOMAIN_BINDING.md.
CONFIRMATIONS=2               # reorg-safety at /credentials/confirm (demo uses 1)
ADMIN_LOOPBACK_ONLY=1         # bind /admin/* custody routes to 127.0.0.1:ADMIN_PORT only
# CORS allowlist (comma-separated origins). Unset => permissive (demo only).
CORS_ALLOW_ORIGINS=https://vet.example.com

# ---- Secrets (generate strong values — do NOT reuse the demo defaults) -----------------------
OPERATOR_PASSWORD=        # generate: openssl rand -hex 32
ADMIN_PASSWORD=           # generate: openssl rand -hex 32
CENTRAL_HMAC_SECRET=      # generate: openssl rand -hex 32  (must match central's CENTRAL_HMAC_SECRET)

# ---- Caddy TLS reverse-proxy -----------------------------------------------------------------
# Public hostname Caddy issues a Let's Encrypt cert for. Needs a DNS A record + open ports 80/443.
DOMAIN=vet.example.com

# ---- Central registry wiring (HMAC-shared appointment source-of-truth) -----------------------
BUSINESS_ID=biz-vet-local
CENTRAL_BASE_URL=https://api.dogtag.io

# ---- Oversight indexer (govarch PR-5: the Traceability portal's data layer) -------------------
# The Traceability page consumes the standalone oversight indexer (stacks/indexer, port 46001),
# joining THIS business's own on-chain credential activity to its DB records. Set the indexer base +
# this business's SCOPED bearer token (an INDEXER_SCOPES entry bound to this signer/clone — see
# stacks/indexer/.env.example). When unset, /trace/* returns 503 and the page shows a first-class
# "indexer not connected" state; the rest of the backend is unaffected. Scoping is enforced BY THE
# INDEXER (this token can only ever see this business's own events) AND re-checked server-side here.
# INDEXER_API_BASE=http://indexer:46001
# INDEXER_SCOPED_TOKEN=   # this business's scoped INDEXER_SCOPES token (INDEXER_TOKEN is an alias)

# ---- Optional: independent consent-prover fallback -------------------------------------------
# Point at the circuits build dir to enable POST /prove-consent. Without it the route fails closed.
# CIRCUITS_BUILD_DIR=/circuits/build
# CONSENT_EXPECTED_ZKEY_SHA256=

# ---- Optional: signed-manifest fallback signing key (M7 §5.1 1B) -----------------------------
# The dogtag manifest signing key: a 32-byte ed25519 seed as 64 lowercase hex chars. When set, this
# instance serves GET /protocol/manifest?version=<v> — the dogtag-signed discovery manifest an app
# verifies OFFLINE (a CACHE/FALLBACK for the on-chain ProtocolRegistry; on conflict on-chain wins).
# UNSET => the route returns 503 (no key, no manifest — fail-closed). The paired PUBLIC key is what an
# app pins to verify. Captain-managed secret; NEVER commit a real value.
# DOGTAG_MANIFEST_SIGNING_KEY=

# ---- Google Calendar OAuth (Phase 7) ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# --- Provider self-service (registry-plan S-15) -------------------------------------------------
# The generation-2 registry set, read by the portal's /provider page. Deployed on ROAX (see
# contracts/deployments/roax.json: ProviderRegistry, DogTagIssuerFactoryV2, ServiceDomainResolver,
# ProviderDirectory) and LEFT BLANK HERE ON PURPOSE.
#
# Blank is not an oversight and not a placeholder to fill in casually. The generation-2 set is
# deployed but UNWIRED: client repointing is cutover step C-9/C-10, and a value shipped in this
# template would opt every deployment that copies it into reading generation 2 without anyone
# deciding to. Unset makes the page say so and check nothing, which is the honest state.
#
# There is deliberately no built-in fallback in the code either, so leaving these blank cannot
# silently fall through to a bundled constant.
VITE_PROVIDER_REGISTRY_ADDR=
VITE_DOGTAG_ISSUER_FACTORY_V2_ADDR=
VITE_SERVICE_DOMAIN_RESOLVER_ADDR=
VITE_PROVIDER_DIRECTORY_ADDR=
# This operator's own provider id, assigned by DogTag at approval. Opaque and KYC-assigned: it is
# NOT derived from the business name, domain, address, signer, clone or factory salt.
VITE_PROVIDER_ID=
