# Vet portal env (copy to .env.local)

# Vet backend base URL used by the API client (via the Vite /api proxy by default).
VITE_VET_API_BASE=/api

# Central admin API base — the whitelist-apply posts issuer-applications here.
# In dev this can be proxied or pointed straight at the central API origin.
VITE_CENTRAL_API_BASE=http://localhost:41870

# Dev proxy target for /api (the vet backend). Defaults to http://localhost:41874.
VITE_VET_API_PROXY=http://localhost:41874

# Reown Cloud projectId for WalletConnect (REQUIRED for real wallet-connect).
# A placeholder is used if unset; WalletConnect transport will not function until set.
VITE_REOWN_PROJECT_ID=REPLACE_WITH_REOWN_PROJECT_ID

# Optional: the deployment URL shown in share/verify QR captions.
VITE_DEPLOYMENT_URL=http://localhost:41873

# Guarded default ROAX RPC. Users may save another same-chain peer in Settings; a bad custom peer
# falls back to this independently guarded default. This changes direct reads only, never the
# central/indexer APIs or the provider used by an injected/WalletConnect wallet for transactions.
VITE_ROAX_RPC=https://devrpc.roax.net

# The per-recordType DogTagIssuer clone this stack issues through, when running in backend mode. In
# wallet mode the address comes from the prepare response (unsignedTx.to) instead.
VITE_DOGTAG_ISSUER_ADDR=

# ---- Deployed contract addresses --------------------------------------------------------------
# EVERY value below ships BLANK and has NO code fallback. Addresses live in
# contracts/deployments/roax.json and reach a build through this file - never as a literal in source,
# which is what `make check-addresses` enforces over the whole tree.
#
# Blank is not an oversight, it is the safe direction. A value shipped in a template opts every
# deployment that copies it into reading a set nobody chose for it, and a pasted address stays
# plausible long after it stops deciding anything: it compiles, typechecks and keeps working right up
# until the next redeploy. Unset makes each surface report itself unconfigured instead.
#
# VITE_DOGTAG_ISSUER_FACTORY_ADDR is the sharpest one: the mandatory issuer-whitelist pillar anchors
# a credential to its issuing clone through this factory's write-once rootIssuer[R]. Unset, the web
# verifier REFUSES by name rather than believing the document's own issuer.documentStore (which sits
# outside the Merkle root and is therefore attacker-controlled).
VITE_PROVIDER_REGISTRY_ADDR=
VITE_DOGTAG_ISSUER_FACTORY_ADDR=
VITE_DOGTAG_ISSUER_IMPL_ADDR=
VITE_DOGTAG_SBT_CONSENT_ADDR=
VITE_VERIFICATION_REGISTRY_CONSENT_ADDR=
VITE_GROTH16_VERIFIER_CONSENT_ADDR=
VITE_PROTOCOL_REGISTRY_ADDR=
VITE_PROVIDER_DIRECTORY_ADDR=
VITE_SERVICE_DOMAIN_RESOLVER_ADDR=
VITE_ADMIN_SIGNER_ADDR=

# Demo mode (default OFF). When set to 1 (or "true"), the portal prefills forms, shows
# "Fill demo data" buttons (a parenthesised variant where a form offers several presets, e.g.
# "Fill demo data (vet)"), and autofills the demo admin password /
# passphrase. NEVER enable in production — in demo mode the vet genesis seed is briefly stashed
# in sessionStorage to auto-fill the confirm step. Unset = secure production behavior.
# VITE_DEMO_MODE=1
