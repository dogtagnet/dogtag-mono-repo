# mobile build artifacts (regenerated by cargo-ndk / gradle / xcodebuild)
android/build/
android/.gradle/
android/app/build/
android/local.properties
android/app/src/main/jniLibs/**/*.so
ios/build/
ios/*.xcframework/
ios/DerivedData/
**/*.xcuserstate
# bundled Groth16 proving keys — 1:1 copies of circuits/build/*.zkey, copied into the app at
# mobile-build time (see docs runbook). Don't double-commit the blobs (Level-A ~65MB, Level-B ~25MB).
android/app/src/main/assets/verification_final.zkey
ios/DogTag/verification_final.zkey
android/app/src/main/assets/consent_final.zkey
ios/DogTag/consent_final.zkey
# bundled circuit witness graphs — 1:1 copies of circuits/build/*.graph, vendored into the app at
# mobile-build time (see docs/MOBILE_BUILD.md). Treated like the zkeys: don't commit the blobs.
android/app/src/main/assets/verification.graph
ios/DogTag/verification.graph
android/app/src/main/assets/consent.graph
ios/DogTag/consent.graph
# stray xcframework backup (the live xcframework is ignored above)
ios/*.xcframework.bak/
